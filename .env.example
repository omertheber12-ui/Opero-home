# xAI / Grok — paste your key, or enter it in the Opero Home setup card
XAI_API_KEY=

# Browserbase — cloud Chrome (required for live browsing)
BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Models (defaults are fine)
OPERO_PLANNER_MODEL=grok-4.7
OPERO_ACTOR_MODEL=grok-4.7

# Optional: vault key is auto-generated into data/vault.key when unset
# OPERO_VAULT_KEY=

PORT=8787

# Use MODEL=fake for a local demo with no Grok key and no Chrome
# MODEL=fake
